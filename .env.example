# Copy to .env and follow docs/DEPLOYMENT.md. No private keys belong in this file: sign with a hardware wallet
# (--ledger) or an encrypted Foundry keystore (--account).
# A private Base mainnet endpoint; public endpoints rate-limit.
BASE_RPC_URL=https://base-rpc.publicnode.com
# A fresh EOA used for nothing else until the deploy: the controller-vault binding relies on its nonce.
DEPLOYER=0x0000000000000000000000000000000000000000
VAULT=0x0000000000000000000000000000000000000000
CONTROLLER=0x0000000000000000000000000000000000000000
PROPOSER=0x0000000000000000000000000000000000000000
EXECUTOR=0x0000000000000000000000000000000000000000
GATEWAY=0x0000000000000000000000000000000000000000
# Read-only M7CapLens: price per share from the latest oracle prices.
LENS=0x0000000000000000000000000000000000000000
# Receives the 990 unlocked seed shares, e.g. a Safe. No contract has an owner and none charges a fee.
SEED_RECEIVER=0x0000000000000000000000000000000000000000
# Seed value in USD: at least about $100 (0.01 of every stock). Rebalances need about $500 of total value;
# see docs/DEPLOYMENT.md, Phase 4.
SEED_USD=125
# ipfs:// plus the raw CID of the exact docs/METHODOLOGY.md bytes, printed in every UMA claim. Print it with
# `python3 scripts/ipfs_cid.py docs/METHODOLOGY.md`; Deploy.s.sol refuses any other value.
METHODOLOGY_URI=ipfs://publish-the-reviewed-methodology-here
# Optional execute deadline (Unix seconds); Maintain.s.sol:Execute defaults to 15 minutes from simulation.
DEADLINE=0
# Immutable UMA bond floor: 1,000 USDC in six-decimal base units, separate from backing capital.
BOND_FLOOR_USDC=1000000000
# Content-addressed (ipfs:// or ar://) bundle: observations.json, its canonical bytes, and the compiler output.
EVIDENCE_URI=ipfs://publish-reviewed-immutable-evidence-here
# Basescan source verification (Etherscan v2 API key) for Deploy.s.sol --verify.
ETHERSCAN_API_KEY=
# Optional overrides; the defaults are config/seed.json and config/snapshot.json.
# SEED_FILE=config/seed.json
# SNAPSHOT_FILE=config/snapshot.json

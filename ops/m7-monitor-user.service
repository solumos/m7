# User-service alternative to m7-monitor.service. Requires loginctl Linger=yes.
# Install as ~/.config/systemd/user/m7-monitor.service with m7-monitor.timer.
[Unit]
Description=M7 reset and vault monitor (read-only)
# Create this file only after checking the actual deployment addresses.
ConditionPathExists=%h/.config/m7/deployed.env

[Service]
Type=oneshot
# Exit 1 means alerts were recorded; exit 2 means the monitor could not complete its read/delivery.
SuccessExitStatus=1
WorkingDirectory=%h/.local/share/m7
EnvironmentFile=%h/.config/m7/deployed.env
Environment=PATH=%h/.local/share/m7/bin:/usr/local/bin:/usr/bin:/bin
Environment=STATE_FILE=%h/.local/state/m7-monitor/state.json
ExecStart=/usr/bin/python3 -m scripts.monitor
TimeoutStartSec=600
NoNewPrivileges=true

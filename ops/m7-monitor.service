# Read-only M7 monitor. Install with the timer; see docs/DEPLOYMENT.md, "Monitoring".
[Unit]
Description=M7 reset and vault monitor (read-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Exit 1 means alerts were recorded; exit 2 means the monitor could not complete its read/delivery.
SuccessExitStatus=1
User=m7
Group=m7
# A checkout of the release commit; the monitor only reads it.
WorkingDirectory=/opt/m7
EnvironmentFile=/etc/m7/monitor.env
# The preflight uses Foundry's cast for selectors and Keccak hashes.
Environment=PATH=/home/m7/.foundry/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=m7-monitor
ExecStart=/usr/bin/python3 scripts/monitor.py
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

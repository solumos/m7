# /etc/m7/monitor.env for ops/m7-monitor.service. Keep it readable by the m7 user only.
# A private Base mainnet endpoint; public endpoints rate-limit.
BASE_RPC_URL=https://your-private-base-endpoint.example
CONTROLLER=0x0000000000000000000000000000000000000000
GATEWAY=0x0000000000000000000000000000000000000000
# M7Lens, for the price per share recorded each run in price-history.jsonl beside the state file.
LENS=0x0000000000000000000000000000000000000000
# Slack or Discord incoming webhook for alerts.
ALERT_WEBHOOK_URL=
# Optional heartbeat, e.g. a healthchecks.io ping URL expecting a ping every 15 minutes with some grace.
HEARTBEAT_URL=
# info, action or critical. action also reports a quarterly reset still undone a week into the quarter.
NOTIFY_LEVEL=action

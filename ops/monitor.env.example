# /etc/m7cap/monitor.env for ops/m7cap-monitor.service. Keep it readable by the m7cap user only.
# A private Base mainnet endpoint; public endpoints rate-limit.
BASE_RPC_URL=https://your-private-base-endpoint.example
CONTROLLER=0x0000000000000000000000000000000000000000
GATEWAY=0x0000000000000000000000000000000000000000
# Reviewed index_snapshot.py output for the current quarter. Replace it each quarter before proposing; until then a
# stranger's proposal raises a critical "no expected snapshot" alert.
EXPECTED_SNAPSHOT=/opt/m7cap/config/snapshot.json
# Slack or Discord incoming webhook for alerts.
ALERT_WEBHOOK_URL=
# Optional heartbeat, e.g. a healthchecks.io ping URL expecting a ping every 15 minutes with some grace.
HEARTBEAT_URL=
# info, action or critical. action also reports due settlements, executions and proposals.
NOTIFY_LEVEL=action
